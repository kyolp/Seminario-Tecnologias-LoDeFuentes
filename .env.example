# Configuración de Entorno - Prototipo Escuela Oficial Rural Mixta Lo de Fuentes
# Plantilla de ejemplo. Copie este archivo como .env y ajuste sus valores locales.
# NUNCA guarde contraseñas reales ni suba .env al repositorio Git.

# Aplicación
APP_NAME="Sistema Web Escuela Lo de Fuentes"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/ProyectoFinal/public
APP_TIMEZONE="America/Guatemala"

# Base de Datos (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=escuela_lo_de_fuentes
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Rutas y almacenamiento
STORAGE_LOGS=storage/logs
